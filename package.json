{
	"name": "brannan.cloud",
	"description": "The private website of me, bananabrann",
	"version": "3.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "dotenv -e .env.local -- vite dev",
		"start": "node build",
		"build": "vite build",
		"preview": "vite preview",
		"test": "echo 'Tests are not set up. The default script that came with Playwright is \"npm run test:integration && npm run test:unit\".'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"dotenv": "^16.4.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/eslint": "^9.6.0",
		"@types/node": "^22.5.4",
		"autoprefixer": "^10.4.20",
		"dotenv-cli": "^7.4.2",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"postcss": "^8.4.45",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"sass-embedded": "^1.85.1",
		"svelte": "^4.2.7",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.10",
		"tsx": "^4.19.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.0.3",
		"vitest": "^2.0.0"
	}
}
